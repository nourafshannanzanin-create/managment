WORKFLOW_APP_NAME=Workflow Hub API
WORKFLOW_API_V1_PREFIX=/api/v1
WORKFLOW_APP_HOST=0.0.0.0
WORKFLOW_APP_PORT=8000
WORKFLOW_DEBUG=true
WORKFLOW_SECRET_KEY=change-this-secret-key
WORKFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=1440

WORKFLOW_MYSQL_HOST=127.0.0.1
WORKFLOW_MYSQL_PORT=3306
WORKFLOW_MYSQL_USER=workflow_user
WORKFLOW_MYSQL_PASSWORD=workflow_password
WORKFLOW_MYSQL_DATABASE=workflow_hub

WORKFLOW_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKFLOW_UPLOAD_DIR=uploads
WORKFLOW_AUTO_INIT_DB=true
WORKFLOW_AUTO_SEED_DB=true
