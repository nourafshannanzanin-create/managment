WORKFLOW_APP_NAME=Workflow Hub API
WORKFLOW_API_V1_PREFIX=/api/v1
WORKFLOW_APP_HOST=0.0.0.0
WORKFLOW_APP_PORT=8000
WORKFLOW_DEBUG=true
WORKFLOW_SECRET_KEY=change-this-secret-key
WORKFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=1440
WORKFLOW_ALLOWED_HOSTS=127.0.0.1,localhost
WORKFLOW_CSRF_TRUSTED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

WORKFLOW_MYSQL_HOST=127.0.0.1
WORKFLOW_MYSQL_PORT=3306
WORKFLOW_MYSQL_USER=workflow_user
WORKFLOW_MYSQL_PASSWORD=workflow_password
WORKFLOW_MYSQL_DATABASE=workflow_hub

WORKFLOW_FRONTEND_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
WORKFLOW_CORS_ALLOW_ALL_ORIGINS=true
WORKFLOW_PUBLIC_APP_URL=http://localhost:5173
WORKFLOW_SECURE_SSL_REDIRECT=false
WORKFLOW_SESSION_COOKIE_SECURE=false
WORKFLOW_CSRF_COOKIE_SECURE=false
WORKFLOW_SECURE_HSTS_SECONDS=0
WORKFLOW_USE_X_FORWARDED_HOST=true
WORKFLOW_STATIC_ROOT=staticfiles
WORKFLOW_MEDIA_URL=/uploads/
WORKFLOW_UPLOAD_DIR=uploads
WORKFLOW_AUTO_INIT_DB=true
WORKFLOW_AUTO_SEED_DB=true
IRANPAYAMAK_BASE_URL=https://api.iranpayamak.com
IRANPAYAMAK_LINE_NUMBER=
IRANPAYAMAK_API_KEY=
SMS_PRICE_PER_100_CHARS=185
SMS_PRICE_PER_SEGMENT=185
ORG_TRIAL_HOURS=24
